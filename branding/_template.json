    "preview": true,
    "playlists": true,
    "devTools": false
  },
  "theme": {
    "mode": "dark",
    "colors": {
      "primary": "#3B82F6",
      "surface": "#0E1116"
    },
    "logo": "assets/customer-slug/logo.svg",
    "icon": "assets/customer-slug/icon.png"
  },
  "window": {
    "width": 1180,
    "height": 760
  }
}
